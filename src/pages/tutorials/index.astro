---
import CategoryPage from "../../components/category/category-page.astro";

import Layout from "../../layouts/page-layout.astro";

import { getPosts } from "../../lib/posts";

const posts = await getPosts({ filter: "tutorials" });
---

<Layout title="Lập Trình">
  <CategoryPage
    heading="Lập Trình"
    collection="tutorial"
    href="/tutorials"
    posts={posts}
  />
</Layout>
