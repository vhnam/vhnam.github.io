---
import CategoryPage from "../../components/category/category-page.astro";

import Layout from "../../layouts/page-layout.astro";

import { getPosts } from "../../lib/posts";

const posts = await getPosts({ filter: "hobbies" });
---

<Layout title="Giải Trí">
  <CategoryPage
    heading="Giải Trí"
    collection="hobby"
    href="/hobbies"
    posts={posts}
  />
</Layout>
