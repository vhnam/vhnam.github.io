---
import type { Post } from "../../lib/posts";
import Breadcrumb from "../common/breadcrumb.astro";
import ScrollToTopButton from "../common/scroll-to-top-button.astro";
import PostList from "./post-list.astro";
import TagList from "./tag-list.astro";

interface Props {
  heading: string;
  collection: "hobby" | "tutorial";
  href: string;
  posts: Post[];
}

const { heading, collection, href, posts } = Astro.props;
const countColor =
  collection === "hobby" ? "text-secondary" : "text-primary";
---

<div class="pt-10 pb-8">
  <Breadcrumb
    collection={collection}
    paths={[
      { label: "Trang Chủ", href: "/" },
      { label: heading, href },
    ]}
  />
</div>

<h1
  class="font-display font-bold text-3xl lg:text-4xl leading-tight tracking-tight mb-8"
>
  {heading}
</h1>

<p class:list={["text-sm mb-8", countColor]}>{posts.length} bài viết.</p>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 pb-12">
  <div class="sticky top-20 self-start">
    <TagList posts={posts} />
  </div>

  <div class="lg:col-span-2 z-10 lg:z-0 bg-background lg:bg-transparent">
    <PostList posts={posts} />
  </div>
</div>

<ScrollToTopButton />
