---
import IconMoon from "#/components/icons/moon.svg";
import IconSun from "#/components/icons/sun.svg";
---

<button
  id="theme-toggle"
  type="button"
  class:list={[
    "inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
    "cursor-pointer",
  ]}
  aria-label="Chuyển sang chế độ tối"
>
  <IconMoon class="size-4 dark:hidden" />
  <IconSun class="hidden size-4 dark:block" />
</button>

<script>
const STORAGE_KEY = "theme";

function getStoredTheme(): "light" | "dark" | null {
  const value = localStorage.getItem(STORAGE_KEY);
  return value === "light" || value === "dark" ? value : null;
}

function getPreferredTheme(): "light" | "dark" {
  return window.matchMedia("(prefers-color-scheme: dark)").matches
    ? "dark"
    : "light";
}

const THEME_TRANSITION_MS = 400;
let themeMotionTimer = 0;

function applyTheme(theme: "light" | "dark") {
  document.documentElement.setAttribute("data-theme", theme);
  document.documentElement.setAttribute("data-pf-theme", theme);
  localStorage.setItem(STORAGE_KEY, theme);

  const toggle = document.getElementById("theme-toggle");
  toggle?.setAttribute(
    "aria-label",
    theme === "dark" ? "Chuyển sang chế độ sáng" : "Chuyển sang chế độ tối",
  );
}

function prefersReducedMotion() {
  return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
}

function toggleTheme() {
  const root = document.documentElement;
  const current = root.getAttribute("data-theme") === "dark" ? "dark" : "light";

  if (!prefersReducedMotion()) {
    root.classList.add("theme-transition");
    window.clearTimeout(themeMotionTimer);
    themeMotionTimer = window.setTimeout(() => {
      root.classList.remove("theme-transition");
    }, THEME_TRANSITION_MS);
    void root.offsetWidth;
  }

  applyTheme(current === "dark" ? "light" : "dark");
}

const stored = getStoredTheme();
applyTheme(stored ?? getPreferredTheme());

document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
</script>
