---
interface Props {
  src: string;
  title?: string;
  height?: string | number;
  width?: string | number;
}

const { src, title = "", height, width } = Astro.props;
const isYouTube = /youtube\.com|youtube-nocookie\.com|youtu\.be/.test(src);
---

<iframe
  src={src}
  title={title}
  height={isYouTube ? undefined : height}
  width={isYouTube ? undefined : width}
  class:list={[isYouTube && "block aspect-video h-auto w-full rounded-md border-0"]}
  allowfullscreen
></iframe>
