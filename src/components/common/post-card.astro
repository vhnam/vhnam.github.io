---
import { getPostHref, type Post } from "../../lib/posts";
import Badge from "./badge.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;

const href = getPostHref(post);
const pubDate = new Date(post.data.pubDate).toLocaleDateString("vi-VN");
const borderColor =
  post.collection === "hobby" ? "border-secondary" : "border-primary";
---

<article
  class="border border-border rounded-md overflow-hidden bg-card transition-transform duration-200 hover:-translate-y-2 hover:shadow-lg"
>
  <a
    href={href}
    class:list={["block h-full p-4 lg:p-6 border-l-4", borderColor]}
  >
    <div class="flex items-center gap-4">
      <span class="font-mono text-muted-foreground text-tiny tracking-wider">
        {pubDate}
      </span>
      <Badge collection={post.collection} />
    </div>
    <h3
      class="font-display font-semibold text-base text-foreground tracking-tight py-2"
    >
      {post.data.title}
    </h3>
    <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
      {post.data.description}
    </p>
  </a>
</article>
