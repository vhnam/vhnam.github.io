---
import { Image } from "astro:assets";

import { getPostHref, type Post } from "../../lib/posts";
import Badge from "../common/badge.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;

const href = getPostHref(post);
const date = post.data.pubDate.toLocaleDateString("vi-VN");
const textColor =
  post.collection === "hobby" ? "text-secondary" : "text-primary";
---

<section class="pb-16">
  <article
    class="grid grid-cols-1 md:grid-cols-2 border border-border rounded-md overflow-hidden bg-card transition-transform duration-200 hover:-translate-y-2 hover:shadow-lg"
  >
    <div class="bg-primary-muted overflow-hidden min-h-64">
      <Image
        src={post.data.cover}
        alt={post.data.title}
        class="size-full object-cover block"
      />
    </div>
    <div class="p-4 lg:p-6 flex flex-col justify-center gap-6">
      <div class="flex items-center justify-between w-full">
        <div class="flex items-center gap-2">
          <Badge collection={post.collection} />
          <time
            datetime={post.data.pubDate.toISOString()}
            class="font-mono font-medium text-xs tracking-wide text-muted-foreground"
          >
            {date}
          </time>
        </div>
        <span
          class="font-mono font-light text-xs tracking-wide text-teal-700 bg-teal-100 dark:text-teal-400 dark:bg-teal-950 px-2 py-1 rounded-md"
        >
          Nổi bật
        </span>
      </div>
      <h2
        class="font-display font-bold text-2xl lg:text-3xl xl:text-4xl leading-tight tracking-tight"
      >
        <a href={href}>{post.data.title}</a>
      </h2>
      <p class="text-base leading-relaxed text-muted-foreground">
        {post.data.description}
      </p>
      <a
        href={href}
        class:list={["font-mono font-medium text-xs tracking-wide underline-offset-3 self-start underline", textColor]}
      >
        Đọc tiếp →
      </a>
    </div>
  </article>
</section>
