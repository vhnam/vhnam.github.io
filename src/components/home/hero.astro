---
import { Image } from "astro:assets";

import taoDanBand from "../../assets/images/tao-dan-band.jpeg";

const START_YEAR = 2014;
---

<header class="grid grid-cols-1 lg:grid-cols-2 gap-4">
  <div class="pt-12 pb-4 lg:pb-12 flex flex-col justify-center">
    <p
      class="font-mono font-medium text-xs text-primary tracking-wide uppercase mb-6"
    >
      Trang cá nhân — Est. {START_YEAR}
    </p>
    <h1
      class="font-display font-bold text-3xl lg:text-4xl xl:text-5xl leading-tight tracking-tight mb-8 max-w-2xl"
    >
      Lập trình, Âm nhạc,
      <br>
      và Nhiếp Ảnh
    </h1>
    <ul
      class="flex items-center gap-4 font-mono text-xs text-muted-foreground tracking-wider pb-8 lg:pt-8"
    >
      <li class="flex gap-2">
        <span class="hidden lg:block text-primary">Vai trò:</span>
        Front-End Engineer
      </li>
      <li aria-hidden="true">
        <span class="rounded-full size-1 bg-border block">&nbsp;</span>
      </li>
      <li class="flex gap-2">
        <span class="hidden lg:block">Tới từ:</span>
        Sài Gòn, Việt Nam
      </li>
    </ul>
  </div>
  <figure class="size-full m-0">
    <Image src={taoDanBand} alt="Tao Dan band" class="size-full object-cover" />
  </figure>
</header>
