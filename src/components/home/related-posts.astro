---
import type { Post } from "../../lib/posts";

import PostCard from "../common/post-card.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section class="pb-20" aria-labelledby="recent-posts-heading">
  <header
    class="flex items-center justify-between mb-6 border-b border-border pb-3 flex-wrap gap-2"
  >
    <h2
      id="recent-posts-heading"
      class="font-mono font-medium text-xs tracking-wide text-muted-foreground uppercase"
    >
      Bài viết gần đây
    </h2>
  </header>

  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {posts.map((post) => (
      <li class="flex">
        <PostCard post={post} />
      </li>
    ))}
  </ul>
</section>
