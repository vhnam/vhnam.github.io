---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  title?: string;
  class?: string;
}

const { src, alt = "", title, class: className } = Astro.props;
const caption = title || alt;
const imageAlt = title ? alt : caption ? "" : alt;
const imageClass = "mx-auto rounded-md";
---

{typeof src === "object" ? (
    caption ? (
    <figure>
        <Image src={src} alt={imageAlt} class:list={[className, imageClass]} />
        <figcaption>{caption}</figcaption>
      </figure>
    ) : (
      <Image src={src} alt={alt} class:list={[className, imageClass]} />
    )
  ) : caption ? (
    <figure>
      <img src={src} alt={imageAlt} class:list={[className, imageClass]} />
      <figcaption>{caption}</figcaption>
    </figure>
  ) : (
    <img src={src} alt={alt} class:list={[className, imageClass]} />
  )}
