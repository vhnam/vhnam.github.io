---
import "glightbox/dist/css/glightbox.min.css";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt?: string;
  title?: string;
  class?: string;
}

const { src, alt = "", title, class: className } = Astro.props;
const caption = title || alt;
const imageClass = "block rounded-md cursor-zoom-in mb-2";
const triggerClass =
  "glightbox mx-auto block w-fit rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-ring";
const href = typeof src === "object" ? src.src : src;
const lightboxData = caption ? `description: ${caption}` : undefined;
---

{typeof src === "object" ? (
    caption ? (
    <figure>
        <a href={href} class={triggerClass} data-glightbox={lightboxData}>
          <Image src={src} alt={alt} class:list={[className, imageClass]} />
        </a>
        <figcaption>{caption}</figcaption>
      </figure>
    ) : (
      <a href={href} class={triggerClass}>
        <Image src={src} alt={alt} class:list={[className, imageClass]} />
      </a>
    )
  ) : caption ? (
    <figure>
      <a href={href} class={triggerClass} data-glightbox={lightboxData}>
        <img src={src} alt={alt} class:list={[className, imageClass]} />
      </a>
      <figcaption>{caption}</figcaption>
    </figure>
  ) : (
    <a href={href} class={triggerClass}>
      <img src={src} alt={alt} class:list={[className, imageClass]} />
    </a>
  )}

<script>
import GLightbox from "glightbox";

GLightbox({ selector: ".glightbox" });
</script>
